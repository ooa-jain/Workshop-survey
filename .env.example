# Copy this file to .env and fill in real values. Never commit .env itself.

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=job_intelligence_survey

# --- SMTP (result emails) ---
# Set EMAIL_ENABLED=false to run without sending mail (e.g. local testing).
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@juooa.cloud
SMTP_PASSWORD=<app-password-or-smtp-key>
SMTP_USE_TLS=true
# Seconds to wait on the mail server before giving up on one email.
SMTP_TIMEOUT=20
EMAIL_FROM=Job Intelligence Workshop <noreply@juooa.cloud>

# --- Admin dashboard (HTTP Basic Auth on /admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=<change-me-before-deploying>

# --- App ---
APP_NAME=Job Search to Job Intelligence
BASE_URL=https://job-intelligence.juooa.cloud
SESSION_SECRET=<change-me-too>

# Tag this run of the workshop. Change per cohort/semester if you re-run
# the workshop later and want separate cohorts in the same database
# (the /admin dashboard and CSV export are scoped to one batch at a time,
# via ?batch=... in the URL -- defaults to this value if omitted).
WORKSHOP_BATCH=2026-final-year

# --- Stage gating -------------------------------------------------------
# Same-day survey opens the instant that student's Pre lands, and closes
# this many hours later (14h covers a 9:30am Pre through to ~11:30pm).
SAMEDAY_WINDOW_HOURS=14
# Week-4 survey stays locked this many days after that student's Pre.
WEEK4_UNLOCK_DAYS=30
# ...then stays open this many days before expiring.
WEEK4_OPEN_DAYS=14
# Emergency override: true opens every stage for everyone (demo/testing).
GATING_DISABLED=false
